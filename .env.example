# =========================================================
# DengueML-UPN - Configuración de Variables de Entorno
# =========================================================
# Este archivo es una PLANTILLA. Copie a .env y complete
# con los valores correspondientes a su entorno.
#
# NUNCA coloque credenciales reales en este archivo.
# =========================================================

# Entorno de ejecución (development | staging | production)
APP_ENV=development

# Clave secreta para la aplicación (cambiar obligatoriamente)
APP_SECRET_KEY=CHANGE_ME

# Nivel de logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Habilitar registro de auditoría (true | false)
ENABLE_AUDIT_LOG=true

# Ruta para almacenar respaldos locales
BACKUP_PATH=./backups
